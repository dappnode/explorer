# =============================================================================
# DAppNode Explorer — environment variables
# Copy this file to `.env.development.local` (for dev) or
# `.env.production.local` (for build) and fill in real values.
#
# Vite inlines any variable prefixed with REACT_APP_ into the bundle at build
# time. Do NOT put real secrets here in a public deploy.
# =============================================================================

# GraphQL endpoint for the package registry subgraph
REACT_APP_SUBGRAPH_URI=

# Bearer token for The Graph gateway. Required in production.
# Use the raw token value; a value prefixed with "Bearer " also works.
REACT_APP_GATEWAY_TOKEN=

# Full public Tropibot dashboard endpoint. No credentials are needed.
# Set this as a GitHub Actions repository variable for deployment.
REACT_APP_DASHBOARD_API_URL=

# IPFS gateway the dashboard checks release hashes against. Defaults to the
# DAppNode dev gateway; it must allow cross-origin GET requests.
REACT_APP_IPFS_DEV_GATEWAY=
